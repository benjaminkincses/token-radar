{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "pollinations": {
      "options": {
        "baseURL": "http://127.0.0.1:8799/v1",
        "apiKey": "relay"
      },
      "models": {
        "openai/gpt-6-astra": {
          "name": "GPT-6 Astra (Pollinations)"
        },
        "z-ai/glm-5.3": {
          "name": "GLM-5.3 (Pollinations)"
        }
      }
    }
  },
  "mcp": {
    "aws-mcp": {
      "enabled": false
    }
  },
  "permission": {
    "external_directory": "allow",
    "bash": "allow",
    "edit": "allow",
    "write": "allow",
    "read": "allow"
  }
}